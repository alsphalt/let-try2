# DARKNOTE HOSTS — environment template
# Copy to .env.local and fill in only what you are integrating.
# Never commit .env.local.

# Public URL of the application
APP_URL=http://localhost:3000

# --- Database (Stage 02) -------------------------------------------------
# PostgreSQL connection string once the adapter is bound.
DATABASE_URL=

# --- Authentication (Stage 02) -------------------------------------------
# Example: credentials | oauth
AUTH_PROVIDER=
AUTH_SECRET=

# --- Bot runtime (Stage 03) ----------------------------------------------
BOT_RUNTIME_URL=

# --- Queue / scheduling (Stage 03) ---------------------------------------
REDIS_URL=

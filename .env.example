# DARKNOTE HOSTS — environment template
# Copy to .env.local and fill in only what you are integrating.
# Never commit .env.local.

# Public URL of the application (set to the HTTPS origin in production so
# session cookies are marked Secure).
APP_URL=http://localhost:3000

# --- Database ------------------------------------------------------------
# SQLite file path. Defaults to ./data/darknote-hosts.db
DATABASE_PATH=

# --- Transactional email (password reset) --------------------------------
# With SMTP configured, reset links are emailed. Without SMTP, local
# development (or AUTH_DEV_RESET_LINKS=true) returns the one-time link to the
# browser so the flow can be completed. Do not enable dev links in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DARKNOTE HOSTS <no-reply@example.com>"
AUTH_DEV_RESET_LINKS=false

# --- Bot runtime (Stage 03) ----------------------------------------------
BOT_RUNTIME_URL=

# --- Queue / scheduling (Stage 03) ---------------------------------------
REDIS_URL=
